.DS_Store
**/.DS_Store

# Local Codex agent configuration.
.agents/
.codex/

# Local notebooks are kept out of the pushed structure for now.
# *.ipynb

# Local dataset files.
bird_songs_dataset/

# Downloaded third-party model/source checkouts stay local.
external/

# Python cache files
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Virtual environments (the Windows setup uses ../bird_song_venv).
.venv/
bird_song_venv/

# Generated preprocessing/training outputs
preview_specs_128/
processed/
spectrograms/
artifacts/spectrograms/
artifacts/generated_spectrograms/
models/
runs/
outputs/
docs/

*.pt
*.ckpt
*.pth

# Latex build artifacts
*.aux
*.bbl
*.blg
*.log
*.toc
*.fdb_latexmk
*.fls
*.out
*.synctex.gz

# Versioned model packages are the only tracked checkpoint boundary.
!artifacts/models/
!artifacts/models/**

# Retired exploratory pilot outputs stay ignored so existing local artifacts
# are preserved without making them maintained branch content again.
outputs/token_transformer_quick/
outputs/token_transformer_quick_audio/
outputs/latent_diffusion_quick/
outputs/latent_diffusion_quick_audio/

# All model checkpoints that belong in the repository live under
# artifacts/models/ and are explicitly unignored above.
