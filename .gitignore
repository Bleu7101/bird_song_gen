.DS_Store
**/.DS_Store

# Local Codex agent configuration.
.agents/
.codex/

# Local dataset files.
bird_songs_dataset/

# Downloaded third-party model/source checkouts stay local.
external/

# Python cache files
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Virtual environments (the Windows setup uses ../bird_song_venv).
.venv/
bird_song_venv/

# Generated preprocessing/training outputs
preview_specs_128/
spectrograms/
outputs/conditional_vae/generated_npy/
outputs/conditional_vae/classifier_input/
outputs/conditional_vae_v2/generated_npy/
outputs/conditional_vae_v3/generated_npy/
outputs/conditional_vae_v2/classifier_input/
outputs/conditional_vae_v3/classifier_input/
processed/
artifacts/
models/
checkpoints/
runs/
*.ckpt
*.pth
*.pt
outputs/

# Local listening exports and generated audio.
*.wav

# Small, explicitly curated publication bundle. Raw runs, caches, resumable
# checkpoints, and bulk audio remain ignored above.
!reports/canonical_models/
!reports/canonical_models/**
